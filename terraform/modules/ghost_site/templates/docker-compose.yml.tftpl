services:
  ghost:
    image: ghost:5-alpine
    restart: always
    environment:
      url: http://${domain_name}
      database__client: mysql
      database__connection__host: ${db_address}
      database__connection__user: ghostuser
      database__connection__password: ${db_password}
      database__connection__database: ghost
    volumes:
      - /opt/ghost/healthcheck.js:/opt/ghost/healthcheck.js:ro
    healthcheck:
      test: ["CMD", "node", "/opt/ghost/healthcheck.js"]
      interval: 15s
      timeout: 10s
      retries: 20
      start_period: 120s
  nginx:
    image: nginx:alpine
    restart: always
    ports:
      - "80:80"
    volumes:
      - /opt/ghost/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      ghost:
        condition: service_healthy
