#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker docker-compose-plugin
systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user

mkdir -p /opt/ghost

cat > /opt/ghost/nginx.conf <<'NGINXCONF'
${nginx_conf}
NGINXCONF

cat > /opt/ghost/healthcheck.js <<'HEALTHCHECK'
${healthcheck_js}
HEALTHCHECK

cat > /opt/ghost/docker-compose.yml <<'COMPOSE'
${compose_content}
COMPOSE

# Wait for the database to be reachable before starting containers so that
# Ghost can connect on the first attempt and become healthy without cycling.
echo "Waiting for database at ${db_address}:3306..."
for i in $(seq 1 120); do
  if (exec 3<>/dev/tcp/${db_address}/3306) 2>/dev/null; then
    echo "Database is reachable (attempt $i)."
    break
  fi
  if [ "$i" -lt 120 ]; then
    echo "Database not reachable yet (attempt $i/120), retrying in 5s..."
    sleep 5
  else
    echo "Timed out waiting for database after $i attempts. Proceeding anyway."
  fi
done

/usr/bin/docker compose -f /opt/ghost/docker-compose.yml up -d
